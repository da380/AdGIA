doc/figures/benchmarks/box_*.png
doc/figures/benchmarks/sphere_*.png

# LaTeX build artefacts of the notes in doc/ (the PDFs are built from the
# .tex sources)
doc/*.aux
doc/*.log
doc/*.out
doc/*.toc
doc/*.pdf
doc/*.fls
doc/*.fdb_latexmk
doc/*.synctex.gz
