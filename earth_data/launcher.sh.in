#!/bin/sh
# Generated by CMake: starts an earth-data script of the source tree
# with the Python environment of this build, from the build tree so that
# outputs land there. Arguments are passed through.
#
# When the build was configured without the Python environment the
# launcher holds the bare `python3`; the probe below then fails before
# the script does, with the fix spelled out.
if [ "@EARTH_DATA_PYTHON_FALLBACK@" = 1 ] && \
   ! "@EARTH_DATA_PYTHON@" -c 'import pyslfp' 2>/dev/null; then
    cat >&2 <<'EOF'
This build was configured without the Python environment, so its
launchers run the bare `python3`, which lacks the required packages.
To fix it:

    cd @CMAKE_SOURCE_DIR@
    poetry env use python3.12   # only if your `python3` is older than 3.12
    poetry install
    cmake @CMAKE_BINARY_DIR@

The last step regenerates the launchers with the new environment.
Alternatively configure with -DEARTH_DATA_PYTHON=<python>.
EOF
    exit 1
fi
exec "@EARTH_DATA_PYTHON@" "@EARTH_DATA_SCRIPT@" "$@"
