#!/bin/sh
# Generated by CMake: starts a script of the benchmark with the Python
# environment, the drivers and the MPI launcher of this build. Arguments
# given here come after those below and override them.
#
# When the build was configured without a benchmarks environment the
# launcher holds the bare `python3`; the probe below then fails before
# the script does, with the fix spelled out.
if [ "@BENCHMARKS_PYTHON_FALLBACK@" = 1 ] && \
   ! "@BENCHMARKS_PYTHON@" -c 'import planetmodel' 2>/dev/null; then
    cat >&2 <<'EOF'
This build was configured without a benchmarks Python environment, so
its launchers run the bare `python3`, which lacks the benchmark
packages. To fix it:

    cd @CMAKE_SOURCE_DIR@
    poetry env use python3.12   # only if your `python3` is older than 3.12
    poetry install
    cmake @CMAKE_BINARY_DIR@

The last step regenerates the launchers with the new environment.
Alternatively configure with -DBENCHMARKS_PYTHON=<python>.
EOF
    exit 1
fi
exec "@BENCHMARKS_PYTHON@" "@BENCHMARK_SCRIPT@" @BENCHMARK_ARGUMENTS@ "$@"
